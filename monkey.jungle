project.manifest = manifest.xml

# These devices have no barometric altimeter: build their view without the
# floors up/down readout (see stairchallengeView.mc drawMetrics variants).
noBarometerDevices = fr55;fr245;fr245m;venusq;venusqm;venusq2;venusq2m;approachs50;vivoactive5;vivoactive6

base.excludeAnnotations = noAltimeter
$(noBarometerDevices).excludeAnnotations = altimeter
